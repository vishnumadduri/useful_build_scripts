diff --git a/hy3dgen/rembg.py b/hy3dgen/rembg.py
index 6247f06..14dabf3 100644
--- a/hy3dgen/rembg.py
+++ b/hy3dgen/rembg.py
@@ -18,7 +18,11 @@ from rembg import remove, new_session
 
 class BackgroundRemover():
     def __init__(self):
-        self.session = new_session()
+        # rembg's own provider auto-detection only checks for
+        # CUDA/ROCM/OpenVINO execution providers, never DirectML - so on
+        # Windows + AMD (no CUDA/ROCm onnxruntime build available there) it
+        # silently falls back to CPU/system RAM unless told otherwise here.
+        self.session = new_session(providers=['DmlExecutionProvider', 'CPUExecutionProvider'])
 
     def __call__(self, image: Image.Image):
         output = remove(image, session=self.session, bgcolor=[255, 255, 255, 0])
