# syntax=docker/dockerfile:1.7

# Requires the builder image from Dockerfile.build to already be built and
# tagged as ros-iceoryx2-builder:
#   docker build -f Dockerfile.build -t ros-iceoryx2-builder .
#   docker build -f Dockerfile.runtime -t ros-iceoryx2 .

FROM ros-iceoryx2-builder AS builder

FROM ros:rolling-ros-base

SHELL ["/bin/bash", "-lc"]

ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /workspace

# Bind-mount (not COPY) the builder's full source tree so it never becomes
# part of a committed layer. Narrow it with the same --packages-up-to used
# to build, then install only the exec (runtime) deps of that subset --
# otherwise rosdep would resolve exec deps for the *entire* ros2.repos tree
# (rviz, rqt, vision demos, etc.), pulling in Qt6/OpenCV/etc. we never build.
RUN --mount=type=bind,from=builder,source=/workspace/src,target=/mnt/src <<'EOF'
set -e
source /opt/ros/rolling/setup.bash
colcon list --base-paths /mnt/src \
  --packages-up-to ros2cli_common_extensions rmw_iceoryx2_cxx rmw_iceoryx2_talker_demo_nodes \
  --paths-only > /tmp/needed_paths.txt
apt-get update
rosdep install --from-paths $(cat /tmp/needed_paths.txt) --ignore-src -r -y \
  --dependency-types=exec \
  --skip-keys "fastcdr rti-connext-dds-7.7.0 urdfdom_headers"
rm -rf /var/lib/apt/lists/*
EOF

# Compiled workspace only (no build/, log/, or src/ intermediates)
COPY --from=builder /workspace/install /workspace/install

RUN echo "source /workspace/install/setup.bash" >> /root/.bashrc

CMD ["/bin/bash"]
